// Type-checks the infrastructure file, which the app's tsconfig deliberately
// excludes: `sst.config.ts` compiles against SST's generated globals ($output,
// the `sst` and `aws` namespaces) rather than the app's module graph.
//
// LOCAL ONLY - run `npm run typecheck:infra`. It reads `.sst/platform`, which is
// gitignored and only exists once `sst install` or a deploy has run, so it is
// not wired into `npm run typecheck` (that one is a required CI check and would
// fail on a fresh runner). Until CI can produce `.sst` cheaply, the infra file's
// first real type check is CodeBuild - which is exactly why it is worth running
// this by hand after touching `sst.config.ts`.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["sst.config.ts", ".sst/platform/config.d.ts"]
}
