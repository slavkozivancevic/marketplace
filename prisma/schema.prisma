// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgTrgm(map: "pg_trgm")]
}

enum UserRole {
  USER
  ADMIN
  SELLER
}

model User {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  email       String    @unique
  name        String?
  imageUrl    String?
  role        UserRole  @default(USER)
  activeOrgId String?
  // Preferred language for all outgoing communications addressed to this user.
  // Synced from the language switcher (setLocale action) and seeded at first
  // sign-in from the Clerk webhook. Recipient-targeted notifications
  // (role changes, seller order emails) read this value; buyer-facing order
  // emails use Order.locale (snapshot at checkout) so the language stays
  // consistent across the order's lifecycle even if the buyer later switches.
  locale      String    @default("en")
  deletedAt   DateTime?

  memberships    Membership[]
  createdInvites Invite[]        @relation("InviteCreatedBy")
  orders         Order[]
  reviews        ProductReview[]

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")

  updatedHistories ProductHistory[] @relation("ProductHistoryUpdatedBy")

  wishlists Wishlist[]
  returns   Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id   String @id @default(uuid())
  name String

  verified Boolean @default(false)

  // Per-seller delivery rule. `shippingFlatRate` is charged once per order for
  // this org's items; waived when the org's subtotal reaches
  // `shippingFreeThreshold` (null = never free). Both in USD base cents
  // (converted to the order currency at checkout, like product prices). Flat
  // rate 0 = always free. Shipping goes fully to the seller - no platform fee,
  // and coupons never reduce it.
  shippingFlatRate      Int  @default(0)
  shippingFreeThreshold Int?

  members          Membership[]
  products         Product[]
  invites          Invite[]
  connectedAccount ConnectedAccount?
  payoutTransactions PaymentTransaction[]
  returns          Return[]
  shipments        Shipment[]
}

// A seller organization's Stripe Connect (Express) account. Created during
// onboarding; the boolean flags are synced from Stripe (account.updated /
// on-demand retrieve). The platform uses separate charges + transfers, so this
// account receives a Transfer for the org's share of each order. Payout ledger
// rows live in PaymentTransaction (type PAYOUT) - this model is account state.
model ConnectedAccount {
  id              String @id @default(uuid())
  organizationId  String @unique
  stripeAccountId String @unique

  // Synced from Stripe: can take charges, can receive payouts, finished KYC.
  chargesEnabled   Boolean @default(false)
  payoutsEnabled   Boolean @default(false)
  detailsSubmitted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id String @id @default(uuid())

  userId String
  orgId  String

  role MembershipRole

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WeightUnit {
  G
  KG
  LB
  OZ
}

enum DimensionUnit {
  CM
  IN
}

/// Which backdrop a brand logo wants, decided from the logo's own luminance
/// (not the active theme) so it never vanishes into a same-tone background.
enum LogoBackdrop {
  AUTO // not yet analyzed; rendered like LIGHT
  LIGHT // dark/colored logo -> light tile
  DARK // light/white logo -> dark tile
  NEUTRAL // logo carries its own opaque background -> no tile
}

model Brand {
  id          String       @id @default(uuid())
  logoUrl     String?
  /// Optional second asset designed for dark surfaces (theme-following render).
  logoUrlDark String?
  /// Backdrop for `logoUrl`. Computed on save from that image; admins may
  /// override AUTO manually.
  logoBackdrop LogoBackdrop @default(AUTO)
  /// Backdrop for `logoUrlDark`, computed from that image independently so each
  /// asset gets the tile its own luminance needs.
  logoBackdropDark LogoBackdrop @default(AUTO)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  translations BrandTranslation[]
  products     Product[]
}

model BrandTranslation {
  id          String  @id @default(uuid())
  brandId     String
  locale      String
  name        String
  slug        String
  description String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
  @@unique([locale, slug])
  @@index([brandId])
}

model Category {
  id       String  @id @default(uuid())
  imageUrl String?
  parentId String?
  order    Int     @default(0)

  // Controls visibility in navigation and search bar dropdown
  isActive   Boolean @default(true)
  // Featured departments appear as cards on the homepage
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  translations CategoryTranslation[]
  products     ProductCategory[]
  attributes   CategoryAttribute[]

  @@index([parentId])
  @@index([isActive, parentId])
  @@index([isFeatured])
}

model CategoryTranslation {
  id          String  @id @default(uuid())
  categoryId  String
  locale      String
  name        String
  slug        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([categoryId])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Product {
  id String @id @default(uuid())

  price          Int
  compareAtPrice Int?
  costPrice      Int?
  stock          Int?

  status ProductStatus @default(DRAFT)

  // Shipping
  requiresShipping Boolean        @default(true)
  weight           Float?
  weightUnit       WeightUnit?
  length           Float?
  width            Float?
  height           Float?
  dimensionUnit    DimensionUnit?

  // Inventory
  barcode String?
  taxable Boolean @default(true)
  taxCode String?

  // Digital
  isDigital Boolean @default(false)

  // Relations
  brandId        String?
  organizationId String
  createdById    String?
  updatedById    String?

  version Int @default(1)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  publishedAt DateTime?
  featuredAt  DateTime?

  brand        Brand?       @relation(fields: [brandId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  translations ProductTranslation[]
  media        ProductMedia[]
  variants     ProductVariant[]

  avgRating   Float @default(0)
  ratingCount Int   @default(0)

  histories       ProductHistory[]
  orderItems      OrderItem[]
  reviews         ProductReview[]
  categories      ProductCategory[]
  tags            ProductTag[]
  wishlists       Wishlist[]
  attributeValues ProductAttributeValue[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, status, deletedAt])
  @@index([brandId])
  @@index([featuredAt])
}

// Per-locale translations for a product. Every supported locale has exactly
// one row per product (including the default). The slug is globally unique
// per locale - this is the canonical URL slug for /[locale]/products/[slug].
//
// `searchText` is a denormalized blob (title + shortDescription + brand name +
// category names) maintained by the application layer on create/update. The
// GIN trigram index targets this column per locale so public search can match
// in the buyer's active language without scanning other locales.
model ProductTranslation {
  id        String @id @default(uuid())
  productId String
  locale    String

  title            String
  slug             String
  description      String
  shortDescription String?
  metaTitle        String?
  metaDescription  String?
  searchText       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([productId])
  @@index([locale, title])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ProductHistory captures a point-in-time snapshot of editable fields so
// admins can preview / roll back to any version. Translation snapshots are
// stored as a JSON map keyed by locale: { [locale]: { title, description } }.
// We snapshot only the default-locale title/description on the row directly
// for fast list rendering; full per-locale data lives in `translationsSnap`.
model ProductHistory {
  id               String        @id @default(uuid())
  productId        String
  version          Int
  title            String
  description      String
  // Per-locale snapshot of translatable fields at this version. Shape:
  //   { [locale]: { title, slug, description, shortDescription, metaTitle, metaDescription } }
  translationsSnap Json?
  price            Int
  status           ProductStatus
  updatedById      String?
  createdAt        DateTime      @default(now())

  product   Product @relation(fields: [productId], references: [id])
  updatedBy User?   @relation("ProductHistoryUpdatedBy", fields: [updatedById], references: [id])

  @@index([productId])
  @@index([version])
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  sku            String
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  stock          Int         @default(0)
  barcode        String?
  weight         Float?
  weightUnit     WeightUnit?
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product         Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  media           ProductVariantMedia[]
  attributeValues ProductVariantAttributeValue[]
  orderItems      OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductVariantMedia {
  variantId String
  mediaId   String
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media     ProductMedia   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([variantId, mediaId])
  @@index([variantId])
  @@index([mediaId])
}

// A single variant axis value: this variant has `option` for `attribute`.
// Variant axes are attributes flagged `isVariantDefining` (e.g. Color, Size),
// so variant values are a controlled vocabulary of AttributeOption - the same
// dictionary the catalog facets read from, eliminating drift between the
// purchasable variations and the browse filters (unified Amazon-style model).
model ProductVariantAttributeValue {
  id          String @id @default(uuid())
  variantId   String
  attributeId String
  optionId    String

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // One value per axis per variant (a variant has exactly one Color, one Size).
  @@unique([variantId, attributeId])
  @@index([variantId])
  @@index([attributeId, optionId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model ProductMedia {
  id String @id @default(uuid())

  productId String

  mediaType MediaType @default(IMAGE)

  // Original asset
  url String
  key String

  // Thumbnail (IMAGE: 300x300 webp) or poster frame (VIDEO: extracted at 1s).
  // Nullable so legacy IMAGE rows migrated from ProductImage stay valid without
  // a backfill pass - the existing thumb pipeline still derives keys from `key`.
  thumbUrl String?
  thumbKey String?

  // Optional metadata, populated by the processor (mostly for VIDEO).
  mimeType   String?
  durationMs Int?
  width      Int?
  height     Int?

  order Int @default(0)

  createdAt DateTime @default(now())

  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantMedia ProductVariantMedia[]

  @@unique([productId, key])
  @@index([productId, order])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELED
}

model Invite {
  id           String         @id @default(uuid())
  email        String
  orgId        String
  role         MembershipRole @default(MEMBER)
  token        String         @unique
  status       InviteStatus   @default(PENDING)
  expiresAt    DateTime
  createdById  String
  createdAt    DateTime       @default(now())
  organization Organization   @relation(fields: [orgId], references: [id])
  createdBy    User           @relation("InviteCreatedBy", fields: [createdById], references: [id])

  @@index([orgId])
  @@index([token])
  @@index([email])
}

model WebhookEvent {
  id          String    @id
  type        String
  processedAt DateTime?
}

// Overall display stage, DERIVED from the two real axes (paymentStatus +
// fulfillmentStatus + cancelledAt) and kept in sync so order lists/filters can
// query a single column. PROCESSING = paid but not shipped; SHIPPED = fulfilled;
// COMPLETED = paid AND delivered. Legacy PENDING_COD/AWAITING_PAYMENT are no
// longer set on new orders (kept for old rows / enum-removal safety).
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  PENDING_COD
  AWAITING_PAYMENT
}

// Money axis. Stripe -> PAID at capture; COD -> UNPAID until cash confirmed.
enum PaymentStatus {
  UNPAID
  PAID
  // Some money returned, but not the whole order total (one or more partial
  // returns / refunds). The order is otherwise still an active, paid order.
  PARTIALLY_REFUNDED
  REFUNDED
}

// Goods axis, derived from per-seller Shipments + a delivery confirmation.
enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  DELIVERED
}

enum PaymentMethod {
  STRIPE
  COD
}

// Direction of a money movement on an order. Amount is always stored positive;
// the type conveys whether money came in (CHARGE), went back to the buyer
// (REFUND), or went out to the seller (PAYOUT).
enum PaymentTransactionType {
  CHARGE
  REFUND
  PAYOUT
  // Platform commission owed by a seller. Recorded for COD orders (the seller
  // collects the cash directly, so the fee can't be netted from a transfer).
  FEE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  SHIPPED
  REFUNDED
}

model Order {
  id              String          @id @default(uuid())
  userId          String
  stripeSessionId String?         @unique
  paymentMethod   PaymentMethod   @default(STRIPE)
  // Two orthogonal axes are the source of truth; `status` is derived from them.
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  cancelledAt       DateTime?
  // Derived display stage (kept in sync from the axes + cancelledAt).
  status          OrderStatus     @default(PENDING)
  // Stored in the smallest unit of `currency` (cents, para, etc.). `total` is the
  // amount actually charged (already net of any coupon discount).
  total           Int
  // Coupon applied at checkout. `couponCode` is a snapshot (survives coupon edits/
  // deletes); `discountAmount` is in the order currency. Platform-funded: sellers
  // still receive their full net, the platform absorbs the discount.
  couponId        String?
  couponCode      String?
  discountAmount  Int             @default(0)
  // Delivery charged at checkout, in the order currency. `shippingTotal` is the
  // whole-order amount (for the buyer total + display); `shippingByOrg` snapshots
  // the per-seller split (orgId -> amount) so payouts stay correct even if an
  // org later edits its rule. `total` already includes shippingTotal. Shipping is
  // the seller's (no platform fee) and is never reduced by a coupon.
  shippingTotal   Int             @default(0)
  shippingByOrg   Json?
  items           OrderItem[]
  reviews         ProductReview[]

  // Locale the buyer was using at checkout time - drives email language
  locale       String  @default("en")
  // Currency the buyer selected at checkout time - drives Stripe charge + email formatting
  currency     String  @default("usd")
  // Exchange rate used at checkout (1 USD = X of currency). Always 1 for USD orders.
  exchangeRate Decimal @default(1) @db.Decimal(12, 6)

  // Shipping address (from Stripe Checkout or COD form)
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id])
  paymentTransactions PaymentTransaction[]
  returns             Return[]
  shipments           Shipment[]
  invoice             Invoice?
  coupon              Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([couponId])
}

enum CouponType {
  PERCENT // value = percent off (1-100)
  FIXED // value = fixed amount off in USD base cents (converted per order currency)
}

// Platform-wide discount code applied at checkout. Validation (active window,
// usage cap, minimum order) lives in the app layer; `usageCount` is incremented
// atomically when an order that used the coupon is created.
model Coupon {
  id         String     @id @default(uuid())
  // Stored uppercase; matched case-insensitively.
  code       String     @unique
  type       CouponType
  value      Int
  // Minimum order subtotal (USD base cents) required to apply; null = none.
  minOrder   Int?
  // Total redemptions allowed across all buyers; null = unlimited.
  usageLimit Int?
  usageCount Int        @default(0)
  expiresAt  DateTime?
  active     Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// Immutable order invoice. Issued once (lazily, on first download or at payment
// completion) with a stable sequential `number` and the S3 key of the rendered
// PDF. The document never changes after issue - that is the point of an invoice.
model Invoice {
  id       String   @id @default(uuid())
  orderId  String   @unique
  // Human-readable sequential invoice number, assigned at issue time.
  number   Int      @unique
  // S3 object key of the rendered PDF (immutable once written).
  pdfKey   String
  issuedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

// Per-seller shipment within an order. Carts are multi-seller, so each seller
// fulfills (ships) its own items independently - one row per (order, seller).
// The presence of a row means that seller's portion is FULFILLED; there is no
// separate status field. Tracking is optional (some sellers ship without it).
model Shipment {
  id             String   @id @default(uuid())
  orderId        String
  organizationId String
  trackingNumber String?
  carrier        String?
  shippedAt      DateTime @default(now())
  // Per-seller delivery confirmation. The order reaches fulfillmentStatus
  // DELIVERED only once every seller's shipment is delivered.
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order        @relation(fields: [orderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([orderId, organizationId])
  @@index([orderId])
  @@index([organizationId])
}

// Return / RMA request, scoped to one seller org within an order (carts are
// multi-seller, so a buyer returns one seller's items at a time). Covers that
// org's whole share of the order - no per-item table yet. Status machine:
// REQUESTED -> APPROVED|REJECTED ; APPROVED -> SHIPPED -> REFUNDED.
model Return {
  id             String       @id @default(uuid())
  orderId        String
  organizationId String
  userId         String // buyer who requested the return
  status         ReturnStatus @default(REQUESTED)
  reason         String?      @db.Text
  // Seller's note on the decision (e.g. why it was rejected).
  resolutionNote String?      @db.Text
  // Amount refunded to the buyer (smallest unit of the order currency), set when
  // the return reaches REFUNDED.
  refundAmount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order        @relation(fields: [orderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  items        ReturnItem[]

  @@index([orderId])
  @@index([organizationId, status])
  @@index([userId])
}

// One line of a return: which order item and how many units are being returned.
// Enables partial returns - the buyer can return a subset of an order's items
// and quantities. Returnable-quantity guards live in the app layer (an item's
// remaining returnable = ordered qty - sum of non-rejected ReturnItem qty).
model ReturnItem {
  id          String @id @default(uuid())
  returnId    String
  orderItemId String
  quantity    Int

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([returnId, orderItemId])
  @@index([returnId])
  @@index([orderItemId])
}

// Append-only ledger of every money movement tied to an order: card charges and
// refunds (Stripe) plus seller payouts (Stripe Connect, item #4) and COD cash
// collection. Gives an audit trail and enables per-item / partial refunds.
// No PSP abstraction - we stay on Stripe + COD (provider reuses PaymentMethod).
model PaymentTransaction {
  id       String                   @id @default(uuid())
  orderId  String
  type     PaymentTransactionType
  status   PaymentTransactionStatus @default(SUCCEEDED)
  provider PaymentMethod
  // Provider's id for this movement: Stripe PaymentIntent (charge), Refund
  // (refund) or Transfer/Payout (payout). Null for COD cash. Unique when set,
  // which doubles as an idempotency key (Postgres treats NULLs as distinct).
  providerId String? @unique
  // Seller this movement belongs to. Set on PAYOUT rows (which org received the
  // transfer) so the seller dashboard can list its payouts; null on CHARGE /
  // REFUND, which are buyer-side and can span multiple orgs in one order.
  organizationId String?
  // Smallest unit of `currency` (cents, para...). Always positive.
  amount   Int
  currency String @default("usd")
  // Provider metadata, failure reason, or COD note.
  note     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order         @relation(fields: [orderId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([organizationId])
  @@index([type, status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  // Stored in the smallest unit of the order's currency
  price     Int

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
}

model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductReview {
  id        String  @id @default(uuid())
  productId String
  userId    String
  orderId   String
  rating    Int
  comment   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// Stores how many units of each currency equal 1 USD.
// USD is always 1.0 (the base currency) and is not stored here.
// Updated by admins or a scheduled refresh job.
model CurrencyRate {
  code      String   @id // e.g. "eur", "rsd"
  rate      Decimal  @db.Decimal(12, 6) // 1 USD = `rate` of this currency
  updatedAt DateTime @updatedAt
}

// Append-only record of who changed what. Written best-effort from server
// actions for money/lifecycle, role and catalog mutations; never edited or
// deleted. Actor is snapshotted (id + email) so the trail stays readable even if
// the user is later removed. System actions (Stripe webhook) have a null actor.
model AuditLog {
  id         String   @id @default(uuid())
  // Who: snapshot, not a FK, so deleting a user never rewrites history.
  actorId    String?
  actorEmail String?
  // Org context the action happened in (seller actions); null for admin/system.
  orgId      String?
  // What: dotted action key (e.g. "order.shipped", "product.updated") + target.
  action     String
  entityType String
  entityId   String
  // Changed fields { field: { from, to } } for updates, or short metadata
  // (e.g. status from->to) for transitions. Null when there's nothing to detail.
  diff       Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

enum SluggedEntityType {
  PRODUCT
  BRAND
  CATEGORY
}

// Old per-locale slugs of products / brands / categories, recorded whenever an
// entity's slug is renamed. The proxy looks a missing slug up here and 308s to
// the entity's current slug, so renamed URLs keep working and their SEO value
// transfers to the new URL instead of hard-404ing. Rows are pruned when a slug
// becomes active again (a new/edited entity reclaims it), so a live URL never
// redirects. No FK to the entity: the discriminator + id are resolved at read
// time, and rows are cleaned up explicitly on entity delete.
model SlugHistory {
  id         String            @id @default(uuid())
  entityType SluggedEntityType
  entityId   String
  locale     String
  slug       String
  createdAt  DateTime          @default(now())

  // One owner per retired slug within an entity type + locale, so a lookup by
  // (type, locale, slug) is unambiguous and reclaiming a slug is a clean upsert.
  @@unique([entityType, locale, slug])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog attribute system (Amazon-style faceting)
//
// A global library of filterable attributes (Attribute) that admins assign to
// categories (CategoryAttribute). Products carry per-attribute values
// (ProductAttributeValue). The storefront derives the left-rail facets for a
// category from its assigned attributes (inherited down the tree) and computes
// per-value counts over the current result set.
//
// Source of truth for FACETS only - independent of the purchasable
// VariantOption system (size/color variations). A future enhancement may
// auto-sync variant options into attribute values, but they stay decoupled here.
// ─────────────────────────────────────────────────────────────────────────────

enum AttributeType {
  SELECT // single choice per product (e.g. Gender)
  MULTI_SELECT // multiple choices per product (e.g. Material)
  RANGE // numeric, filtered as a min/max range (e.g. Screen size)
  BOOLEAN // yes/no (e.g. Wireless)
}

// A reusable, globally-defined attribute. `key` is a stable machine identifier
// used in URL params (`attr_<key>`) and code; human labels live in translations.
model Attribute {
  id        String        @id @default(uuid())
  key       String        @unique
  type      AttributeType
  // Unit suffix shown next to RANGE values, e.g. "inch", "GB". Null otherwise.
  unit      String?
  order     Int           @default(0)
  // When true, this attribute can be used as a product variant axis (e.g. Color,
  // Size). Only SELECT attributes are eligible. Variant values then come from
  // this attribute's options, so the same dictionary powers variations + facets.
  isVariantDefining Boolean @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations  AttributeTranslation[]
  options       AttributeOption[]
  categories    CategoryAttribute[]
  values        ProductAttributeValue[]
  variantValues ProductVariantAttributeValue[]

  @@index([key])
}

model AttributeTranslation {
  id          String @id @default(uuid())
  attributeId String
  locale      String
  label       String // "Boja" / "Color"

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, locale])
  @@index([attributeId])
}

// A predefined choice for a SELECT / MULTI_SELECT attribute. `value` is the
// stable machine key (e.g. "red"); the localized display label lives in
// translations.
model AttributeOption {
  id          String @id @default(uuid())
  attributeId String
  value       String
  order       Int    @default(0)

  attribute     Attribute                    @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations  AttributeOptionTranslation[]
  productValues ProductAttributeValue[]
  variantValues ProductVariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
}

model AttributeOptionTranslation {
  id       String @id @default(uuid())
  optionId String
  locale   String
  label    String // "Crvena" / "Red"

  option AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
  @@index([optionId])
}

// Assigns an attribute to a category. Assignments are inherited down the tree:
// a department's attributes apply to all its descendant categories. `order`
// controls facet ordering in the sidebar; `isFilterable` lets an attribute be
// captured on products without (yet) appearing as a facet.
model CategoryAttribute {
  categoryId   String
  attributeId  String
  order        Int     @default(0)
  isFilterable Boolean @default(true)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([attributeId])
}

// A single attribute value on a product. Exactly one of optionId /
// valueNumeric / valueBool is populated depending on the attribute's type.
// MULTI_SELECT attributes produce one row per selected option.
model ProductAttributeValue {
  id           String   @id @default(uuid())
  productId    String
  attributeId  String
  optionId     String? // SELECT / MULTI_SELECT
  valueNumeric Float? // RANGE
  valueBool    Boolean? // BOOLEAN

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([productId])
  // Facet count aggregation paths:
  @@index([attributeId, optionId])
  @@index([attributeId, valueNumeric])
}
