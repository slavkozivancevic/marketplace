// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique
  email        String   @unique
  name         String?
  imageUrl     String?
  role         UserRole @default(USER)
  activeOrgId  String?
  deletedAt    DateTime?

  memberships  Membership[]
  createdInvites Invite[] @relation("InviteCreatedBy")
  orders         Order[]
  reviews        ProductReview[]

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")

  updatedHistories ProductHistory[] @relation("ProductHistoryUpdatedBy")

  wishlists        Wishlist[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Organization {
  id   String @id @default(uuid())
  name String

  verified Boolean @default(false)

  members  Membership[]
  products Product[]
  invites  Invite[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id String @id @default(uuid())

  userId String
  orgId  String

  role MembershipRole

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WeightUnit {
  G
  KG
  LB
  OZ
}

enum DimensionUnit {
  CM
  IN
}

model Brand {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  description String?
  imageUrl    String?
  parentId    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products ProductCategory[]

  @@unique([slug, parentId])
  @@index([parentId])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Product {
  id          String @id @default(uuid())

  title            String
  slug             String
  description      String
  shortDescription String?
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2)
  costPrice        Decimal? @db.Decimal(10, 2)
  stock            Int?

  status ProductStatus @default(DRAFT)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Shipping
  requiresShipping Boolean @default(true)
  weight           Float?
  weightUnit       WeightUnit?
  length           Float?
  width            Float?
  height           Float?
  dimensionUnit    DimensionUnit?

  // Inventory
  barcode String?
  taxable Boolean @default(true)
  taxCode String?

  // Digital
  isDigital Boolean @default(false)

  // Relations
  brandId        String?
  organizationId String
  createdById    String?
  updatedById    String?

  version Int @default(1)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  publishedAt DateTime?
  featuredAt  DateTime?

  brand        Brand?        @relation(fields: [brandId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  createdBy    User?         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?         @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
  options  VariantOption[]

  avgRating   Float @default(0)
  ratingCount Int   @default(0)

  histories   ProductHistory[]
  orderItems  OrderItem[]
  reviews     ProductReview[]
  categories  ProductCategory[]
  tags        ProductTag[]
  wishlists   Wishlist[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, title])
  @@index([organizationId, status, deletedAt])
  @@index([brandId])
  @@index([featuredAt])
}

model ProductHistory {
  id        String   @id @default(uuid())
  productId String
  version   Int
  title     String
  description String
  price     Decimal @db.Decimal(10,2)
  status    ProductStatus
  updatedById String?
  createdAt DateTime @default(now())
  product  Product @relation(fields: [productId], references: [id])
  updatedBy User? @relation("ProductHistoryUpdatedBy", fields: [updatedById], references: [id])
  @@index([productId])
  @@index([version])
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  sku            String
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  costPrice      Decimal?    @db.Decimal(10, 2)
  stock          Int         @default(0)
  barcode        String?
  weight         Float?
  weightUnit     WeightUnit?
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ProductVariantImage[]
  optionValues VariantOptionValue[]
  orderItems   OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductVariantImage {
  variantId String
  imageId   String
  order     Int @default(0)
  createdAt DateTime @default(now())
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  image   ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  @@id([variantId, imageId])
  @@index([variantId])
  @@index([imageId])
}

model VariantOption {
  id String @id @default(uuid())
  productId String
  name String
  order Int @default(0)
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  values VariantOptionValue[]
  @@index([productId])
}

model VariantOptionValue {
  id String @id @default(uuid())
  optionId  String
  variantId String
  value String
  order Int @default(0)
  option  VariantOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@index([variantId])
  @@index([optionId])
}

model ProductImage {
  id String @id @default(uuid())

  productId String

  url String
  key String

  order Int @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantImages ProductVariantImage[]

  @@index([productId, order])
  @@unique([productId, key])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELED
}
model Invite {
  id          String         @id @default(uuid())
  email       String
  orgId       String
  role        MembershipRole @default(MEMBER)
  token       String         @unique
  status      InviteStatus   @default(PENDING)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime       @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  createdBy    User         @relation("InviteCreatedBy", fields: [createdById], references: [id])
  @@index([orgId])
  @@index([token])
  @@index([email])
}

model WebhookEvent {
  id String @id
  type String
  processedAt DateTime?
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  PENDING_COD
}

enum PaymentMethod {
  STRIPE
  COD
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  stripeSessionId String?       @unique
  paymentMethod   PaymentMethod @default(STRIPE)
  status          OrderStatus   @default(PENDING)
  total           Decimal       @db.Decimal(10, 2)
  items           OrderItem[]
  reviews         ProductReview[]

  // Locale the buyer was using at checkout time — drives email language
  locale          String      @default("en")

  // Shipping address (from Stripe Checkout or COD form)
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  userId    String
  orderId   String
  rating    Int
  comment   String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}
