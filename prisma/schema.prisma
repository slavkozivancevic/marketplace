// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgTrgm(map: "pg_trgm")]
}

enum UserRole {
  USER
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique
  email        String   @unique
  name         String?
  imageUrl     String?
  role         UserRole @default(USER)
  activeOrgId  String?
  deletedAt    DateTime?

  memberships  Membership[]
  createdInvites Invite[] @relation("InviteCreatedBy")
  orders         Order[]
  reviews        ProductReview[]

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")

  updatedHistories ProductHistory[] @relation("ProductHistoryUpdatedBy")

  wishlists        Wishlist[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Organization {
  id   String @id @default(uuid())
  name String

  verified Boolean @default(false)

  members  Membership[]
  products Product[]
  invites  Invite[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id String @id @default(uuid())

  userId String
  orgId  String

  role MembershipRole

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WeightUnit {
  G
  KG
  LB
  OZ
}

enum DimensionUnit {
  CM
  IN
}

model Brand {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  description  String?
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]
}

model Category {
  id          String    @id @default(uuid())
  name          String
  slug          String
  description   String?
  translations  Json?
  imageUrl    String?
  parentId    String?
  order       Int       @default(0)

  // Controls visibility in navigation and search bar dropdown
  isActive    Boolean   @default(true)
  // Featured departments appear as cards on the homepage
  isFeatured  Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products ProductCategory[]

  @@unique([slug, parentId])
  @@index([parentId])
  @@index([isActive, parentId])
  @@index([isFeatured])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Product {
  id          String @id @default(uuid())

  title            String
  slug             String
  description      String
  shortDescription String?
  translations     Json?
  // Denormalized search blob (title + shortDescription + brand name + category names,
  // plus their Serbian translations). Maintained by the application layer on
  // create/update; used as the sole target for public product search via a GIN
  // pg_trgm index.
  searchText       String?
  price            Int
  compareAtPrice   Int?
  costPrice        Int?
  stock            Int?

  status ProductStatus @default(DRAFT)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Shipping
  requiresShipping Boolean @default(true)
  weight           Float?
  weightUnit       WeightUnit?
  length           Float?
  width            Float?
  height           Float?
  dimensionUnit    DimensionUnit?

  // Inventory
  barcode String?
  taxable Boolean @default(true)
  taxCode String?

  // Digital
  isDigital Boolean @default(false)

  // Relations
  brandId        String?
  organizationId String
  createdById    String?
  updatedById    String?

  version Int @default(1)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  publishedAt DateTime?
  featuredAt  DateTime?

  brand        Brand?        @relation(fields: [brandId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  createdBy    User?         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?         @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  media    ProductMedia[]
  variants ProductVariant[]
  options  VariantOption[]

  avgRating   Float @default(0)
  ratingCount Int   @default(0)

  histories   ProductHistory[]
  orderItems  OrderItem[]
  reviews     ProductReview[]
  categories  ProductCategory[]
  tags        ProductTag[]
  wishlists   Wishlist[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, title])
  @@index([organizationId, status, deletedAt])
  @@index([brandId])
  @@index([featuredAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductHistory {
  id        String   @id @default(uuid())
  productId String
  version   Int
  title     String
  description String
  price     Int
  status    ProductStatus
  updatedById String?
  createdAt DateTime @default(now())
  product  Product @relation(fields: [productId], references: [id])
  updatedBy User? @relation("ProductHistoryUpdatedBy", fields: [updatedById], references: [id])
  @@index([productId])
  @@index([version])
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  sku            String
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  stock          Int         @default(0)
  barcode        String?
  weight         Float?
  weightUnit     WeightUnit?
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  media        ProductVariantMedia[]
  optionValues VariantOptionValue[]
  orderItems   OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductVariantMedia {
  variantId String
  mediaId   String
  order     Int @default(0)
  createdAt DateTime @default(now())
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   ProductMedia   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@id([variantId, mediaId])
  @@index([variantId])
  @@index([mediaId])
}

model VariantOption {
  id String @id @default(uuid())
  productId String
  name String
  translations Json?
  order Int @default(0)
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  values VariantOptionValue[]
  @@index([productId])
}

model VariantOptionValue {
  id String @id @default(uuid())
  optionId  String
  variantId String
  value String
  order Int @default(0)
  option  VariantOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@index([variantId])
  @@index([optionId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model ProductMedia {
  id String @id @default(uuid())

  productId String

  mediaType MediaType @default(IMAGE)

  // Original asset
  url String
  key String

  // Thumbnail (IMAGE: 300x300 webp) or poster frame (VIDEO: extracted at 1s).
  // Nullable so legacy IMAGE rows migrated from ProductImage stay valid without
  // a backfill pass — the existing thumb pipeline still derives keys from `key`.
  thumbUrl String?
  thumbKey String?

  // Optional metadata, populated by the processor (mostly for VIDEO).
  mimeType   String?
  durationMs Int?
  width      Int?
  height     Int?

  order Int @default(0)

  createdAt DateTime @default(now())

  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantMedia  ProductVariantMedia[]

  @@index([productId, order])
  @@unique([productId, key])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELED
}
model Invite {
  id          String         @id @default(uuid())
  email       String
  orgId       String
  role        MembershipRole @default(MEMBER)
  token       String         @unique
  status      InviteStatus   @default(PENDING)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime       @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  createdBy    User         @relation("InviteCreatedBy", fields: [createdById], references: [id])
  @@index([orgId])
  @@index([token])
  @@index([email])
}

model WebhookEvent {
  id String @id
  type String
  processedAt DateTime?
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  PENDING_COD
}

enum PaymentMethod {
  STRIPE
  COD
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  stripeSessionId String?       @unique
  paymentMethod   PaymentMethod @default(STRIPE)
  status          OrderStatus   @default(PENDING)
  // Stored in the smallest unit of `currency` (cents, para, etc.)
  total           Int
  items           OrderItem[]
  reviews         ProductReview[]

  // Locale the buyer was using at checkout time — drives email language
  locale          String      @default("en")
  // Currency the buyer selected at checkout time — drives Stripe charge + email formatting
  currency        String      @default("usd")
  // Exchange rate used at checkout (1 USD = X of currency). Always 1 for USD orders.
  exchangeRate    Decimal     @default(1) @db.Decimal(12, 6)

  // Shipping address (from Stripe Checkout or COD form)
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  // Stored in the smallest unit of the order's currency
  price     Int

  order   Order          @relation(fields: [orderId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  userId    String
  orderId   String
  rating    Int
  comment   String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// Stores how many units of each currency equal 1 USD.
// USD is always 1.0 (the base currency) and is not stored here.
// Updated by admins or a scheduled refresh job.
model CurrencyRate {
  code      String   @id        // e.g. "eur", "rsd"
  rate      Decimal  @db.Decimal(12, 6)  // 1 USD = `rate` of this currency
  updatedAt DateTime @updatedAt
}
