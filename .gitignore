# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# sst / opennext (deploy artifacts + local platform types + secret state)
.sst
.open-next

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# local email/template previews (rendered ad-hoc for visual QA, never committed)
_email_preview.html
*.preview.html
/previews/

# test coverage
coverage/

# playwright
playwright-report/
test-results/
/e2e/.auth/

# claude code local overrides (personal, never committed)
.claude/settings.local.json
